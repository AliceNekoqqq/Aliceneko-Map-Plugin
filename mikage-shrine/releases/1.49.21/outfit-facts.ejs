var outfitState=getvar('stat_data',{scope:'message',withMsg:{role:'any'},defaults:{},clone:true});
if(typeof lastMessageId==='number')for(var outfitFloor=lastMessageId;outfitFloor>=Math.max(0,lastMessageId-63);outfitFloor--){var outfitCandidate=getvar('stat_data',{scope:'message',withMsg:{id:outfitFloor},defaults:{},clone:true});if(outfitCandidate && outfitCandidate.玩家 && outfitCandidate.巴卫 && outfitCandidate.记录 && Array.isArray(outfitCandidate.记录.共同经历)){outfitState=outfitCandidate;break;}}
function outfitMemory(state) {
 const rows=state && state.记录 || {},events=Array.isArray(rows.事件)?rows.事件:[],ids=Object.create(null),looks=Object.create(null);
 events.forEach(function(e,i){if(e && typeof e.编号==='string')ids[e.编号]=i;});
 function key(actor,id){return actor+':'+(actor==='tomoe' && id==='school-human'?'school':id);}
 (Array.isArray(rows.共同经历)?rows.共同经历:[]).forEach(function(m){
  if(!m || typeof m.摘要!=='string' || !Object.prototype.hasOwnProperty.call(ids,m.编号))return;
  const match=/^【衣装(记忆|命名|回提)·(player|tomoe)·([a-z][a-z0-9-]{0,30})】/.exec(m.摘要);if(!match)return;
  const k=key(match[2],match[3]),entry=looks[k]||(looks[k]={name:'',moments:[],recallAt:-1000});
  const text=m.摘要.slice(match[0].length);
  if(match[1]==='命名'){try{const name=JSON.parse(text);if(typeof name==='string'&&name.length<=24)entry.name=name;}catch{}}
  else if(match[1]==='记忆')entry.moments.push({event:m.编号,text:text.slice(0,260)});
  else entry.recallAt=ids[m.编号];
 });
 Object.values(looks).forEach(function(entry){entry.first=entry.moments[0]||null;entry.moments=entry.moments.slice(-3);entry.recentRecall=events.length-1-entry.recallAt<3;delete entry.recallAt;});
 return looks;
}
function outfitEscape(v){return String(v==null?'':v).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
var outfitReady=outfitState && outfitState.玩家 && outfitState.巴卫 && outfitState.记录;
var outfitBook=outfitReady?outfitMemory(outfitState):{};
var outfitCurrent=outfitReady?[{actor:'player',id:outfitState.玩家.衣装},{actor:'tomoe',id:outfitState.巴卫.服装}]:[];
var outfitUser='';
if(outfitReady && typeof getChatMessage==='function')try{var outfitMessage=getChatMessage(-1,'user');if(typeof outfitMessage==='string')outfitUser=outfitMessage.slice(-4096);}catch(outfitReadError){}
var outfitNames={"player":{"daily":"便服","shrine":"巫女值勤服","work":"修缮服","festival":"祭典浴衣","sakura":"樱染散策","seabreeze":"潮音夏服","forest":"山茶披肩","ceremony":"月白奉礼","swim":"海盐晴蓝","school":"樱坂晴日","gym":"学园体操服","kagura":"神乐千早","shiromuku":"新娘白无垢","heian-travel":"市女笠旅装"},"tomoe":{"usual":"常服","work":"修缮装","festival":"祭典羽织","aoba":"青岚羽织","journey":"潮汐远行","grove":"林间行装","moon":"月下礼装","swim":"晴汐浪纹","yako":"野狐旧影","city":"绀夜归途","winter":"檐下薄雪","school":"樱坂薄暮","school-human":"樱坂薄暮·人间伪装","butler":"学园祭执事服","kariginu":"神乐狩衣","chibi":"幼狐巴卫·万宝槌缩小装","wedding":"黑纹付羽织袴"}};
var outfitDeferred=/(不聊|不提|不谈|别提|别聊|先别提|先别聊|不想(?:聊|谈|提)|不要(?:聊|谈|提)|先不说).{0,12}(衣服|衣装|穿着|衣柜|旧事|往事|回忆)|(衣服|衣装|穿着|衣柜).{0,12}(先放一边|先搁下|以后再聊|改天再聊)/.test(outfitUser);
var outfitRecall=/记得|回忆|那次|上次|以前|旧事|往事|纪念|命名|名字|叫啥|叫什么|起名|穿过|第一次|最早/.test(outfitUser);
var outfitTopic=/衣服|衣装|衣柜|穿着|这套|那套|这身|那身|纪念名/.test(outfitUser);
var outfitAll=Object.keys(outfitBook).map(function(k){var split=k.indexOf(':'),actor=k.slice(0,split),id=k.slice(split+1);return {actor:actor,id:id,data:outfitBook[k],label:outfitNames[actor]&&outfitNames[actor][id]||''};});
var outfitNamed=outfitAll.filter(function(x){return [x.label,x.data.name].some(function(n){return typeof n==='string'&&n.length>=2&&outfitUser.indexOf(n)>=0;});});
var outfitSelected=outfitNamed.length?outfitNamed:outfitCurrent.map(function(x){var key=x.actor+':'+(x.actor==='tomoe'&&x.id==='school-human'?'school':x.id);return {actor:x.actor,id:x.id,data:outfitBook[key]};});
var outfitPlayer=/我的|我那|我这/.test(outfitUser),outfitTomoe=/巴卫|你的|你那|你这/.test(outfitUser);
var outfitFirstOnly=/第一次|最早/.test(outfitUser),outfitNameOnly=/纪念名|命名|名字|叫啥|叫什么|起名/.test(outfitUser)&&!/记得|回忆|那次|上次|以前|穿过|第一次|最早/.test(outfitUser);
var outfitRelevant=!outfitDeferred && outfitRecall && (outfitTopic||outfitNamed.length)?outfitSelected.filter(function(x){return x.data&&(x.data.name||x.data.first)&&(!(outfitPlayer!==outfitTomoe)||x.actor===(outfitPlayer?'player':'tomoe'));}).slice(0,2):[];
